\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Representation-controlled comparison. With the same Gradient Boosting classifier, same-ID residual features are not better in the closed Test01 setting, but they improve attack-F1 under the three shifted settings. Numbers above each group denote the attack-F1 change of GRAIN-CAN{} over raw-window statistics.}}{12}{}\protected@file@percent }
\newlabel{fig:sameclf}{{3}{12}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Attack-F1 gain of same-ID residual features over raw-window statistics in the CT\&T vehicle-shift by attack-shift matrix. The categorical matrix is more appropriate than a line plot because Test01--Test04 are not temporal samples.}}{12}{}\protected@file@percent }
\newlabel{fig:shiftmatrix}{{4}{12}{}{figure.4}{}}
