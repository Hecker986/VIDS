\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Representative CT\&T results with attack windows as the positive class. The thresholded primary columns follow Sec.~\ref {sec:metrics}: Precision (\(P\)) is attack-positive precision, Recall (\(R\)) is attack recall, Attack-F1 (\(F_1^{\mathrm  {atk}}\)) is attack-positive F1, and FNR/FPR are false-negative/false-positive rates. AUPR and Recall@FPR are supplementary score-based metrics and are reported only when comparable scores are available. Values are rounded to three decimals; ``--'' denotes unavailable or not recomputed for that row.}}{11}{}\protected@file@percent }
\newlabel{tab:main}{{5}{11}{}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Representation-controlled comparison using the same Gradient Boosting classifier and W100 windows. Column names follow Sec.~\ref {sec:metrics}: Precision (\(P\)), Recall (\(R\)), Attack-F1 (\(F_1^{\mathrm  {atk}}\)), FNR, and FPR are thresholded primary metrics; AUPR and Recall@FPR are supplementary score-based metrics. Values are rounded to three decimals; ``--'' denotes unavailable or not recomputed for that row.}}{11}{}\protected@file@percent }
\newlabel{tab:sameclf}{{6}{11}{}{table.6}{}}
