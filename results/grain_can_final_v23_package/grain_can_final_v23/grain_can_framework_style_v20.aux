\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Feature-before-window extraction exposes sparse local attack evidence before aggregation. A raw long window can dilute a short burst, while same-ID residual features create visible timing or payload-change spikes before the detector sees the window.}}{5}{}\protected@file@percent }
\newlabel{fig:mechanism}{{1}{5}{}{figure.1}{}}
