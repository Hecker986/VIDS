\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Feature ablation on Test04. Same-ID timing residuals are the dominant local-behavior signal under joint shift, while raw ID and payload-heavy variants can be less robust.}}{13}{}\protected@file@percent }
\newlabel{fig:ablation}{{5}{13}{}{figure.5}{}}
